Ngeneric:Invisible-Pin|pin@390||-1020|50|||||SIM_spice_card(D5G1;)S[* 4-bit asynchronous ripple up-counter - ENCS3330,".include \"C5_models.txt\"",Vdd vdd 0 DC 5,"* 10 MHz clock: rising edges at 70 ns, 170 ns, 270 ns, ...",Vclk CLK 0 PULSE(5 0 20n 2n 2n 48n 100n),.subckt INV A Y VP VN,MP1 Y A VP VP PMOS L=0.6u W=3u,MN1 Y A VN VN NMOS L=0.6u W=3u,.ends INV,.subckt NAND2 A B Y VP VN,MP1 Y A VP VP PMOS L=0.6u W=3u,MP2 Y B VP VP PMOS L=0.6u W=3u,MN1 Y A nmid VN NMOS L=0.6u W=3u,MN2 nmid B VN VN NMOS L=0.6u W=3u,.ends NAND2,.subckt DLATCH D E Q Qbar VP VN,XINV   D    Dbar  VP VN INV,XSET   D    E     Sbar  VP VN NAND2,XRESET Dbar E     Rbar  VP VN NAND2,XQ     Sbar Qbar  Q     VP VN NAND2,XQBAR  Rbar Q     Qbar  VP VN NAND2,.ends DLATCH,"* D, CLK, Q, Qbar, master-Q, master-Qbar, VDD, GND",.subckt DFF D CLK Q Qbar QM QMbar VP VN,XCLKINV1 CLK     clk_bar VP VN INV,XCLKINV2 clk_bar clk_buf VP VN INV,XMASTER  D  clk_bar QM QMbar VP VN DLATCH,XSLAVE   QM clk_buf Q  Qbar  VP VN DLATCH,.ends DFF,* Toggle connection: D = Qbar,* Ripple connection: each Qbar clocks the next DFF,XFF0 Q0bar CLK   Q0 Q0bar M0 M0bar vdd 0 DFF,XFF1 Q1bar Q0bar Q1 Q1bar M1 M1bar vdd 0 DFF,XFF2 Q2bar Q1bar Q2 Q2bar M2 M2bar vdd 0 DFF,XFF3 Q3bar Q2bar Q3 Q3bar M3 M3bar vdd 0 DFF,* 250 fF load on each visible counter output,Cq0 Q0 0 250f,Cq1 Q1 0 250f,Cq2 Q2 0 250f,Cq3 Q3 0 250f,* Start in binary 0000,.ic V(Q0)=0 V(Q0bar)=5,.ic V(Q1)=0 V(Q1bar)=5,.ic V(Q2)=0 V(Q2bar)=5,.ic V(Q3)=0 V(Q3bar)=5,.ic V(M0)=0 V(M0bar)=5,.ic V(M1)=0 V(M1bar)=5,.ic V(M2)=0 V(M2bar)=5,.ic V(M3)=0 V(M3bar)=5,.options plotwinsize=0,.tran 0 1700n 0 20p,"* Power and energy, measured after startup",.measure tran iavg AVG I(Vdd) FROM=100n TO=1700n,.measure tran pavg PARAM=-5*iavg,.measure tran energy PARAM=pavg*1600n,* Ripple delay: external clock edge until Q3 changes,.measure tran tcq3_rise TRIG V(CLK) VAL=2.5 RISE=8 TARG V(Q3) VAL=2.5 RISE=1,.measure tran tcq3_fall TRIG V(CLK) VAL=2.5 RISE=16 TARG V(Q3) VAL=2.5 FALL=1,.end]
