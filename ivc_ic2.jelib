Ngeneric:Invisible-Pin|pin@137||-257|409|||||SIM_spice_card(D5G1;)S[* CMOS positive-edge-triggered D flip-flop,* Two D latches and two clock inverters,".include \"C5_models.txt\"",.param VDD=5,* ==================================================,* CMOS inverter,* Ports: input output supply ground,* ==================================================,.subckt INV A Y VP VN,MP1 Y A VP VP PMOS L=0.6u W=3u,MN1 Y A VN VN NMOS L=0.6u W=3u,.ends INV,* ==================================================,* Two-input CMOS NAND gate,* Ports: inputA inputB output supply ground,* ==================================================,.subckt NAND2 A B Y VP VN,* Parallel PMOS,MP1 Y A VP VP PMOS L=0.6u W=3u,MP2 Y B VP VP PMOS L=0.6u W=3u,* Series NMOS,MN1 Y    A nmid VN NMOS L=0.6u W=3u,MN2 nmid B VN   VN NMOS L=0.6u W=3u,.ends NAND2,* ==================================================,* Active-HIGH D latch,* Ports: data enable Q Qbar supply ground,* ==================================================,.subckt DLATCH D E Q Qbar VP VN,* Complement of D,XINV D dbar VP VN INV,* Input gating,* sbar = NOT(D AND E),* rbar = NOT(dbar AND E),XSET   D    E sbar VP VN NAND2,XRESET dbar E rbar VP VN NAND2,* Cross-coupled NAND latch,XQ    sbar Qbar Q    VP VN NAND2,XQBAR rbar Q    Qbar VP VN NAND2,.ends DLATCH,* ==================================================,* Positive-edge-triggered D flip-flop,* Ports: data clock Q Qbar supply ground,* ==================================================,.subckt DFF D CLK Q Qbar VP VN,"* Two clock inverters, matching the diagram",* Master enable = inverted CLK,* Slave enable  = twice-inverted CLK,XCLKINV1 CLK     clk_bar VP VN INV,XCLKINV2 clk_bar clk_buf VP VN INV,* Master latch: transparent while CLK is LOW,XMASTER D  clk_bar QM QMbar VP VN DLATCH,* Slave latch: transparent while CLK is HIGH,* Its data input comes from the master's Q,XSLAVE  QM clk_buf Q  Qbar  VP VN DLATCH,.ends DFF,* ==================================================,* Supply,* ==================================================,vsupply vdd 0 DC {VDD},* ==================================================,* Input signals,* D changes between clock edges to demonstrate hold.,"* Clock rising edges occur near 25, 125, and 225 ns.",* ==================================================,vdata D 0 PULSE(0 {VDD} 10n 2n 2n 18n 40n),vclock CLK 0 PULSE(0 {VDD} 25n 2n 2n 48n 100n),* ==================================================,* D flip-flop instance,* ==================================================,XDFF D CLK Q Qbar vdd 0 DFF,* Output loads,CQ    Q    0 250f,CQBAR Qbar 0 250f,* ==================================================,* Supply power and energy over 10 ns to 290 ns,* ==================================================,.measure tran iavg AVG I(vsupply) FROM=10n TO=290n,.measure tran pavg PARAM -VDD*iavg,.measure tran ipk MIN I(vsupply) FROM=10n TO=290n,.measure tran pmax PARAM -VDD*ipk,.measure tran energy PARAM pavg*280n,* ==================================================,* Simulation,* ==================================================,.options plotwinsize=0,.tran 0.05n 300n 0 0.05n,.end]
Ngeneric:Invisible-Pin|pin@138||-260|264|||||SIM_spice_card(D5G1;)S[* CMOS Inverter - multi-cycle transient + power/energy,.include C5_models.txt,.param VDD=5,.param TR=2ns TF=2ns        ; input rise/fall,.param PW=20ns PER=40ns      ; high time and full period,vdd vdd 0 DC {VDD},"* repeating square wave: many switches, no hand-listed PWL points",vin in 0 PULSE(0 {VDD} 5ns {TR} {TF} {PW} {PER}),cload out 0 250fF,* ---- instantaneous supply power: p(t) = VDD * (-I(vdd)) ----,"* I(vdd) is negative when sourcing, so negate to get power delivered",.measure tran pinst PARAM='1'        ; placeholder so name exists (optional),"* measure on a settled cycle (2nd pulse), not the first",.measure tran tphl TRIG v(in)  val='0.5*VDD' rise=2,+                   TARG v(out) val='0.5*VDD' fall=2,.measure tran tplh TRIG v(in)  val='0.5*VDD' fall=2,+                   TARG v(out) val='0.5*VDD' rise=2,.measure tran tp param='(tphl+tplh)/2'      ; average propagation delay,* output edge rates,.measure tran trise TRIG v(out) val='0.1*VDD' rise=2 TARG v(out) val='0.9*VDD' rise=2,.measure tran tfall TRIG v(out) val='0.9*VDD' fall=2 TARG v(out) val='0.1*VDD' fall=2,* ================= POWER & ENERGY =================,* Average supply power over one settled period (40 ns: 45 ns -> 85 ns),.measure tran iavg  AVG  I(vdd) FROM=45ns TO=85ns,.measure tran pavg  PARAM='-VDD*iavg'        ; average power (W),* Peak instantaneous power over that period,.measure tran ipk   MIN  I(vdd) FROM=45ns TO=85ns   ; most-negative = biggest draw,.measure tran pmax  PARAM='-VDD*ipk'         ; peak power (W),* Energy per period = average power * period  (J),.measure tran energy PARAM='pavg*PER',* Energy per switching transition (2 edges per period -> /2),.measure tran e_per_switch PARAM='energy/2',.tran 0.05ns 200ns          ; ~5 cycles,.end]
Ngeneric:Invisible-Pin|pin@139||-234|105|||||SIM_spice_card(D5G1;)S[* CMOS active-HIGH D latch,* Four NAND gates and one inverter,".include \"C5_models.txt\"",.param VDD=5,* ==================================================,* CMOS inverter,* Ports: input output supply ground,* ==================================================,.subckt INV A Y VP VN,MP1 Y A VP VP PMOS L=0.6u W=3u,MN1 Y A VN VN NMOS L=0.6u W=3u,.ends INV,* ==================================================,* Two-input CMOS NAND gate,* Ports: inputA inputB output supply ground,* ==================================================,.subckt NAND2 A B Y VP VN,* Parallel PMOS,MP1 Y A VP VP PMOS L=0.6u W=3u,MP2 Y B VP VP PMOS L=0.6u W=3u,* Series NMOS,MN1 Y    A nmid VN NMOS L=0.6u W=3u,MN2 nmid B VN   VN NMOS L=0.6u W=3u,.ends NAND2,* ==================================================,* Supply,* ==================================================,vsupply vdd 0 DC {VDD},* ==================================================,* Input signals,* E starts HIGH so the latch initializes from D=0.,* D also changes while E is LOW to demonstrate hold.,* ==================================================,vdata D 0 PULSE(0 {VDD} 10n 2n 2n 18n 40n),venable E 0 PWL(,+ 0     {VDD},+ 55n   {VDD},+ 57n   0,+ 115n  0,+ 117n  {VDD},+ 175n  {VDD},+ 177n  0,+ 235n  0,+ 237n  {VDD},+ 300n  {VDD},+ ),* ==================================================,* Input gating,* sbar = NOT(D AND E),* rbar = NOT(dbar AND E),* ==================================================,XINV D dbar vdd 0 INV,XSET   D    E sbar vdd 0 NAND2,XRESET dbar E rbar vdd 0 NAND2,* ==================================================,* Cross-coupled NAND latch,* Q    = NOT(sbar AND Qbar),* Qbar = NOT(rbar AND Q),* ==================================================,XQ    sbar Qbar Q    vdd 0 NAND2,XQBAR rbar Q    Qbar vdd 0 NAND2,* Output loads,CQ    Q    0 250f,CQBAR Qbar 0 250f,* ==================================================,* Supply power and energy over 10 ns to 290 ns,* ==================================================,.measure tran iavg AVG I(vsupply) FROM=10n TO=290n,.measure tran pavg PARAM -VDD*iavg,.measure tran ipk MIN I(vsupply) FROM=10n TO=290n,.measure tran pmax PARAM -VDD*ipk,.measure tran energy PARAM pavg*280n,* ==================================================,* Simulation,* ==================================================,.options plotwinsize=0,.tran 0.05n 300n 0 0.05n,.end]
